#compdef worktree wt
#
# Tab-completion for the `worktree` command (and its `wt` alias). See
# `worktree --help` (the "Shell completion" section) for how to wire this
# into your shell.

_worktree() {
  local -a subcommands
  subcommands=(
    'up:create a worktree for a branch'
    'open:jump straight to an existing worktree'
    'remove:remove an existing worktree'
    'rename:rename an existing worktree'
    'list:list worktrees'
    'config:configure IDE/port defaults'
    'version:show installed version and location'
    'update:update the installed tool'
    'uninstall:remove the installed tool'
    'help:show help'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' subcommands

    # Keep global options separate from subcommands. Adding them at a blank
    # command position interferes with zsh's partial subcommand matching
    # (for example, `wt uni<Tab>`). Once the user starts an option, offer the
    # two help spellings directly.
    if [[ "$PREFIX" == -* ]]; then
      local -a help_options help_descriptions
      help_options=(--help -h)
      help_descriptions=('--help  -- show help' '-h      -- show help')
      compadd -U -d help_descriptions -- "${help_options[@]}"
    fi
    return
  fi

  case ${words[2]} in
    up)
      if (( CURRENT == 3 )); then
        # Both are valid: `worktree up <existing-worktree-name>` re-opens it
        # (see `worktree --help`), same as typing its actual branch. One flat
        # list, one _describe call — each candidate carries its own inline
        # description ("existing worktree" vs "branch"). Bracing ${raw} is
        # required: bare $raw:existing gets parsed as the ":e" parameter
        # modifier (extension), silently eating "$raw:e" and leaving garbage.
        local -a candidates raw
        candidates=()
        for raw in ${(f)"$(worktree __complete-worktrees 2>/dev/null)"}; do
          candidates+=("${raw}:existing worktree")
        done
        for raw in ${(f)"$(worktree __complete-branches 2>/dev/null)"}; do
          candidates+=("${raw}:branch")
        done
        _describe 'branch or worktree' candidates
      fi
      ;;
    open)
      if (( CURRENT == 3 )); then
        local -a targets
        targets=(${(f)"$(worktree __complete-open-targets 2>/dev/null)"})
        _describe 'worktree (name or branch)' targets
      fi
      ;;
    remove)
      # No CURRENT==3 gate, unlike `open`/`rename`: `remove` takes any
      # number of worktree names plus options, in any order, so every
      # position after the subcommand offers both.
      local -a candidates raw
      candidates=()
      for raw in ${(f)"$(worktree __complete-worktrees 2>/dev/null)"}; do
        candidates+=("${raw}:existing worktree")
      done
      candidates+=(
        '--select:interactive checkbox picker'
        '--all:target every worktree except the current one'
        '--force:skip the dirty-worktree confirm, force-remove right away'
        '--delete-branches:delete every removed worktree'\''s branch, no question'
        '--keep-branches:never delete branches, no question'
      )
      _describe 'worktree or option' candidates
      ;;
    rename)
      if (( CURRENT == 3 )); then
        local -a names
        names=(${(f)"$(worktree __complete-worktrees 2>/dev/null)"})
        _describe 'worktree' names
      fi
      # CURRENT == 4 (the new name) is free text — nothing to suggest.
      ;;
    uninstall)
      if (( CURRENT == 3 )); then
        _values 'option' '--purge-config[also remove personal configuration]'
      fi
      ;;
  esac
}

_worktree "$@"
